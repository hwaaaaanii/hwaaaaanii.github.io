<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jeonghwan Choi</title>
<meta name="description" content="Jeonghwan Choi, Ph.D. student at the Data Intelligence System Lab, KAIST. Retrieval-Augmented Generation, LLM evaluation, human-AI alignment, LLM agent simulation, and Physical AI.">
<!-- favicons shipped with the Chirpy blog, reused so the tab icon stays consistent
     between the homepage and /blog/ -->
<link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicons/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicons/favicon-16x16.png">
<link rel="shortcut icon" href="/assets/img/favicons/favicon.ico">
<link rel="manifest" href="/assets/img/favicons/site.webmanifest">
<meta name="theme-color" content="#ffffff">
<style>
/* No webfonts and no icon font. System stacks only: it loads instantly, and the
   Georgia/Helvetica pairing reads as a document rather than a product page.
   One ink colour, one link colour, no gradients, no shadows, no hover motion. */
:root{
  --ink:#1a1a1a; --body:#333; --soft:#666; --faint:#8a8a8a;
  --rule:#dcdcdc; --rule-soft:#ebebeb; --link:#14507a; --page:#fff;
  /* one extra colour, reserved for venue names. deliberately not the link
     blue, so a coloured venue never reads as something clickable */
  --venue:#8c3131;
  /* just enough to take the hard edge off. large radii were part of what made
     the old cards look generated, so this stays small and uniform */
  --radius:4px;
  --serif:Charter,"Bitstream Charter","Sitka Text",Cambria,Georgia,serif;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{font-family:var(--sans);color:var(--body);background:var(--page);
  line-height:1.65;margin:0;font-size:16px;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:var(--serif);color:var(--ink);margin:0;font-weight:600;line-height:1.25}
a{color:inherit;text-decoration:none}
img{max-width:100%}
.lnk,.news-content a,.honor-content a,footer a{color:var(--link);text-decoration:underline;
  text-decoration-thickness:1px;text-underline-offset:2px}
.lnk:hover,.news-content a:hover,.honor-content a:hover{text-decoration-thickness:2px}

/* ---------- nav ---------- */
.top-nav{position:sticky;top:0;z-index:50;background:var(--page);border-bottom:1px solid var(--rule)}
.nav-inner{max-width:1180px;margin:0 auto;padding:0 1.5rem;min-height:3.5rem;
  display:flex;justify-content:space-between;align-items:center;gap:1.5rem}
.brand{font-family:var(--serif);font-size:1.15rem;font-weight:600;color:var(--ink);
  white-space:nowrap;flex-shrink:0}
.nav-links{display:flex;gap:1.1rem;list-style:none;margin:0;padding:0;flex-wrap:wrap;
  justify-content:flex-end;row-gap:.35rem}
.nav-item{font-size:.85rem;color:var(--soft)}
.nav-item:hover{color:var(--ink)}
.nav-item.active{color:var(--ink);font-weight:600}

/* ---------- layout ---------- */
main{padding:3rem 0}
.wrap{max-width:1180px;margin:0 auto;padding:0 1.5rem}
.grid-layout{display:grid;grid-template-columns:1fr;gap:2.5rem}
/* no align-items:start here: the profile column must stretch to the full row
   height, otherwise sticky has no room to travel */
@media(min-width:1024px){.grid-layout{grid-template-columns:250px 1fr;gap:4rem}}
.profile-card{position:sticky;top:5rem;max-height:calc(100vh - 6.5rem);overflow-y:auto}
.content-column{display:flex;flex-direction:column;gap:3.25rem}

/* ---------- profile ---------- */
.profile-image-container{max-width:170px;margin:0 0 1.1rem}
.profile-image-container img{width:100%;display:block;border-radius:var(--radius)}
.profile-name{margin-bottom:1.1rem}
.profile-name h1{font-size:1.5rem;font-weight:600;margin-bottom:.2rem}
.profile-name .role{font-size:.95rem;color:var(--body);margin:0 0 .15rem}
.profile-name .affil{color:var(--soft);font-size:.88rem;margin:0;line-height:1.5}
/* inline SVG marks, no icon font and no extra request. Simple Icons for the two
   scholar services (CC0) and Bootstrap Icons for the rest (MIT) */
.social-links{display:flex;flex-direction:column;gap:.5rem;margin-bottom:1.6rem;
  padding-bottom:1.4rem;border-bottom:1px solid var(--rule-soft)}
.social-btn{display:inline-flex;align-items:center;gap:.55rem;font-size:.85rem;color:var(--body)}
.social-btn .si{width:15px;height:15px;flex-shrink:0;color:var(--faint)}
.social-btn span{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:2px;
  text-decoration-color:var(--rule)}
.social-btn:hover{color:var(--link)}
.social-btn:hover .si{color:var(--link)}
.social-btn:hover span{text-decoration-color:currentColor}
.social-btn.cv-btn{font-weight:600;color:var(--ink)}
.social-btn.cv-btn .si{color:var(--venue)}
.ri-card h3{font-size:.78rem;font-family:var(--sans);font-weight:600;color:var(--faint);
  text-transform:uppercase;letter-spacing:.09em;margin-bottom:.6rem}
.ri-card ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.4rem}
.ri-card li{color:var(--body);font-size:.88rem;line-height:1.45}

/* ---------- sections ---------- */
section{scroll-margin-top:5rem}
.section-header{margin-bottom:1.25rem;padding-bottom:.4rem;border-bottom:1px solid var(--rule);
  display:flex;justify-content:space-between;align-items:baseline;gap:1rem}
.section-header h2{font-size:1.3rem;font-weight:600}
.view-all{font-size:.82rem;color:var(--link);white-space:nowrap;text-decoration:underline;
  text-decoration-thickness:1px;text-underline-offset:2px}
.formal-font{font-size:1rem;line-height:1.7;color:var(--body)}
.formal-font p{margin:0 0 1rem}
.formal-font strong{color:var(--ink);font-weight:600}
.highlight-box{margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--rule-soft);
  font-size:.92rem;color:var(--soft)}
.highlight-box p{margin:0}

/* ---------- research thrusts ---------- */
/* boxed again, because four bare paragraphs floated. square corners, hairline
   border, flat fill: the structure comes back without the shadow, gradient and
   hover lift that made these read as generated cards */
.thrust-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1rem}
.thrust-card{border:1px solid var(--rule);background:#fbfbfa;padding:1.1rem 1.25rem;
  border-radius:var(--radius)}
.thrust-card h3{font-size:1rem;font-weight:600;margin-bottom:.4rem}
.thrust-card p{font-size:.92rem;line-height:1.6;color:var(--soft);margin:0}

/* ---------- news ---------- */
.news-list{display:flex;flex-direction:column;gap:.7rem}
.news-item{display:grid;grid-template-columns:72px 1fr;gap:1.25rem;align-items:baseline}
.news-date{font-family:var(--mono);font-size:.8rem;color:var(--faint);white-space:nowrap}
.news-content{font-size:.93rem;color:var(--body);line-height:1.6}
.news-content strong{color:var(--ink);font-weight:600}

/* ---------- publications ---------- */
.pub-year-group{margin-bottom:2rem}
.pub-year-header{font-family:var(--sans);font-size:.78rem;font-weight:600;letter-spacing:.09em;
  text-transform:uppercase;color:var(--faint);margin-bottom:.9rem}
.pub-year-count{font-weight:400;letter-spacing:0;margin-left:.3rem}
.pub-list-ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:1.4rem}
.pub-list-item{display:flex;gap:1.4rem;align-items:flex-start;line-height:1.5}
.pub-content-wrapper{flex:1 1 auto;min-width:0}
.pub-line-1{display:flex;flex-wrap:wrap;align-items:baseline;gap:.5rem;margin-bottom:.3rem}
.pub-title-text{font-family:var(--serif);font-weight:600;color:var(--ink);font-size:1.05rem;line-height:1.35}
/* co-authors sit back so the one bold name carries real contrast. bold alone
   against near-black neighbours was not enough to catch the eye */
.pub-line-2{font-size:.9rem;color:var(--faint);margin-bottom:.25rem}
.pub-line-2 strong{color:#000;font-weight:700}
.pub-line-2 .meta-note{color:var(--faint);font-weight:400}
.pub-line-3{font-size:.88rem;color:var(--body);display:flex;flex-wrap:wrap;align-items:baseline;gap:.4rem}
.pub-line-4{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:.35rem}
.pub-link-btn{font-size:.82rem;color:var(--link);text-decoration:underline;
  text-decoration-thickness:1px;text-underline-offset:2px}
.pub-link-btn:hover{text-decoration-thickness:2px}
/* the venue is what a reader scans for, so it gets the heading serif at full
   ink rather than sitting quieter than the author list */
.pub-venue-tag{font-family:var(--serif);font-style:italic;font-size:1rem;font-weight:600;
  color:var(--venue);white-space:nowrap}
/* Under Review is a status, not a venue, so it stays out of the venue colour */
.tag-under-review{color:var(--faint);font-weight:400}
.pub-badge-highlight{font-size:.76rem;font-weight:600;color:var(--faint);letter-spacing:.03em;
  white-space:nowrap}
.pub-badge-highlight::before{content:"[ "}
.pub-badge-highlight::after{content:" ]"}
/* framework figures run 1.6:1 to 5:1, so the frame stays 2:1 and the image is
   contained rather than cropped */
.pub-thumbnail-box{width:190px;aspect-ratio:2/1;flex-shrink:0;overflow:hidden;background:var(--page);
  border:1px solid var(--rule);display:flex;align-items:center;justify-content:center;padding:.3rem;
  border-radius:var(--radius)}
.pub-thumb-img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;display:block}
/* papers with no figure get an empty frame: nothing to choose, nothing to maintain */
.pub-thumb-fallback{width:100%;height:100%;background:#fafafa;border-radius:2px}

/* ---------- education / honors ---------- */
.timeline{display:flex;flex-direction:column;gap:1.35rem}
.timeline-item{display:flex;gap:1rem;align-items:flex-start}
.tl-icon{display:none}
.tl-content h3{font-size:1rem;font-weight:600;margin-bottom:.1rem}
.tl-content .when{font-size:.85rem;color:var(--faint);margin:0}
.tl-content .desc{font-size:.9rem;color:var(--soft);margin:.2rem 0 0;line-height:1.6}
.tl-content ul{margin:.3rem 0 0;padding-left:1.1rem;font-size:.88rem;color:var(--soft);line-height:1.65}
.honors-list{display:flex;flex-direction:column;gap:.85rem}
.honor-item{display:grid;grid-template-columns:60px 1fr;gap:1.25rem;align-items:baseline}
.honor-year{font-family:var(--mono);font-size:.8rem;color:var(--faint);white-space:nowrap}
.honor-content h3{font-size:.97rem;font-weight:600;margin-bottom:.05rem}
.honor-content p{margin:0;color:var(--soft);font-size:.88rem}

/* ---------- contact ---------- */
.contact-row{display:flex;align-items:baseline;gap:.5rem;color:var(--body);font-size:.95rem}
.contact-pair{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:1.25rem 2.5rem;align-items:start}
.contact-card h3{font-size:.78rem;font-family:var(--sans);font-weight:600;color:var(--faint);
  text-transform:uppercase;letter-spacing:.09em;margin-bottom:.35rem}

footer{border-top:1px solid var(--rule);padding:1.75rem 1.5rem;margin-top:3.5rem;
  color:var(--faint);font-size:.82rem}
footer .wrap{padding:0 1.5rem}

.sub-note{font-size:.85rem;color:var(--faint);margin:.3rem 0 0}
.pub-note{font-size:.85rem;color:var(--faint)}

@media(max-width:1100px){
  /* nav becomes a scrollable strip under the name, never a hidden menu */
  .nav-inner{flex-direction:column;align-items:stretch;gap:.1rem;padding:.5rem 0 0;min-height:0}
  .brand{font-size:1.05rem;padding:0 1.25rem}
  .nav-links{flex-wrap:nowrap;overflow-x:auto;justify-content:flex-start;
    gap:1rem;padding:.3rem 1.25rem .5rem;scrollbar-width:none;-ms-overflow-style:none}
  .nav-links::-webkit-scrollbar{display:none}
  .nav-item{font-size:.8rem}
  section{scroll-margin-top:6rem}
  .profile-card{top:6rem;max-height:calc(100vh - 7.5rem)}
}

/* single column below 1024px, so the card stops sticking and scrolls with the
   page. must come after the 1100px block to win on max-height */
@media(max-width:1023px){
  .profile-card{position:static;max-height:none;overflow:visible}
  .profile-image-container{max-width:150px}
}
@media(max-width:640px){
  .news-item,.honor-item{grid-template-columns:1fr;gap:.15rem}
  .pub-list-item{flex-direction:column;gap:.8rem}
  .pub-thumbnail-box{width:100%}
  .section-header{flex-direction:column;align-items:flex-start;gap:.25rem}
}
</style>
</head>
