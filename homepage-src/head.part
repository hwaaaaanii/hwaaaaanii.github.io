<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jeonghwan Choi</title>
<meta name="description" content="Jeonghwan Choi, Ph.D. student at the Data Intelligence System Lab, KAIST. Retrieval-Augmented Generation, human-AI alignment, LLM agent simulation.">
<!-- favicons shipped with the Chirpy blog, reused so the tab icon stays consistent
     between the homepage and /blog/ -->
<link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicons/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicons/favicon-16x16.png">
<link rel="shortcut icon" href="/assets/img/favicons/favicon.ico">
<link rel="manifest" href="/assets/img/favicons/site.webmanifest">
<meta name="theme-color" content="#ffffff">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{
  --bg:#f8fafc; --fg:#0f172a; --primary:#1e293b; --accent:#d4a562;
  --accent-dark:#b7791f; --muted:#64748b; --line:#e2e8f0;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:var(--fg);
  background:var(--bg);line-height:1.6;margin:0;-webkit-font-smoothing:antialiased}
h1,h2,h3,h4{font-family:'Crimson Text',Georgia,serif;margin:0}
a{color:inherit;text-decoration:none}
img{max-width:100%}

/* ---------- nav ---------- */
.top-nav{position:fixed;top:0;left:0;right:0;z-index:50;background:rgba(255,255,255,.92);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--line);
  box-shadow:0 4px 30px rgba(0,0,0,.03)}
.nav-inner{max-width:1480px;margin:0 auto;padding:0 1.5rem;min-height:4.5rem;
  display:flex;justify-content:space-between;align-items:center;gap:1.5rem}
.brand{font-family:'Crimson Text',serif;font-size:1.5rem;font-weight:600;color:var(--primary);
  transition:color .2s;white-space:nowrap;flex-shrink:0}
.brand:hover{color:var(--accent)}
.nav-links{display:flex;gap:1.35rem;list-style:none;margin:0;padding:0;flex-wrap:wrap;
  justify-content:flex-end;row-gap:.5rem}
.nav-item{position:relative;font-weight:500;font-size:.9rem;color:#475569;transition:color .2s;white-space:nowrap}
.nav-item:hover,.nav-item.active{color:var(--primary)}
.nav-item::after{content:'';position:absolute;width:0;height:2px;bottom:-5px;left:0;
  background:var(--accent);transition:width .3s ease}
.nav-item:hover::after,.nav-item.active::after{width:100%}

/* ---------- layout ---------- */
main{min-height:100vh;padding:7rem 0 3rem}
.wrap{max-width:1480px;margin:0 auto;padding:0 1.5rem}
.grid-layout{display:grid;grid-template-columns:1fr;gap:2.5rem}
@media(min-width:1024px){.grid-layout{grid-template-columns:320px 1fr;gap:4rem;align-items:start}}
.profile-card{position:sticky;top:6.5rem}
.content-column{display:flex;flex-direction:column;gap:3.5rem}

/* ---------- profile ---------- */
.profile-image-container{max-width:190px;margin:0 auto 1.5rem}
.profile-image-container img{width:100%;border-radius:.85rem;box-shadow:0 8px 24px -14px rgba(15,23,42,.45);display:block}
.profile-name{text-align:center;margin-bottom:1.5rem}
.profile-name h1{font-size:1.9rem;font-weight:700;color:var(--primary);margin-bottom:.15rem}
.profile-name .ko{font-size:1rem;color:#94a3b8;margin:0 0 .5rem}
.profile-name .role{font-size:1.05rem;color:var(--accent);font-weight:500;margin:0 0 .25rem}
.profile-name .affil{color:#64748b;font-size:.9rem;margin:0;line-height:1.45}
.social-links{display:flex;flex-wrap:wrap;justify-content:center;gap:.6rem;margin-bottom:1.5rem}
.social-btn{width:2.5rem;height:2.5rem;display:inline-flex;align-items:center;justify-content:center;
  border-radius:999px;border:1px solid var(--line);color:#475569;background:#fff;
  transition:all .2s ease;box-shadow:0 6px 18px -16px rgba(15,23,42,.55)}
.social-btn:hover{border-color:rgba(212,165,98,.5);color:var(--accent-dark);transform:translateY(-1px)}
/* the CV is the one link people actually hunt for, so it gets a label instead of
   a bare icon and carries the accent colour */
.social-btn.cv-btn{width:auto;padding:0 .85rem;gap:.4rem;font-size:.82rem;font-weight:700;
  letter-spacing:.04em;border-color:rgba(212,165,98,.55);color:var(--accent-dark);
  background:linear-gradient(180deg,#fffdf8 0%,#fdf6e9 100%)}
.social-btn.cv-btn:hover{border-color:var(--accent);background:#fdf1dd}
.ri-card{background:#f1f5f9;border-radius:.85rem;padding:1.25rem}
.ri-card h3{font-size:1.1rem;font-weight:700;color:var(--primary);margin-bottom:.9rem;
  padding-bottom:.5rem;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:.5rem}
.ri-card ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.7rem}
.ri-card li{display:flex;align-items:center;color:#334155;font-size:.875rem;font-weight:500}
.ri-card li i,.ri-card li .ic{color:rgba(212,165,98,.9);margin-right:.75rem;width:1.25rem;text-align:center;font-size:.85rem}

/* ---------- sections ---------- */
section{scroll-margin-top:6.5rem}
.section-header{margin-bottom:1.5rem;display:flex;justify-content:space-between;align-items:flex-end;gap:1rem}
.section-header h2{position:relative;display:inline-block;font-size:1.85rem;font-weight:700;color:var(--primary);z-index:0}
.section-header h2::after{content:'';position:absolute;bottom:2px;left:0;width:40%;height:3px;
  background:rgba(212,165,98,.3);z-index:-1}
.view-all{font-size:.85rem;font-weight:500;color:var(--accent);white-space:nowrap;transition:color .2s}
.view-all:hover{color:var(--accent-dark)}
.formal-font{font-family:'Times New Roman',Times,serif;font-size:1.05rem;line-height:1.7;color:#475569;text-align:justify}
.formal-font p{margin:0 0 1rem}
.highlight-box{background:rgba(212,165,98,.1);border-left:4px solid var(--accent);
  padding:1rem 1.15rem;border-radius:0 .5rem .5rem 0;font-family:'Inter',sans-serif;font-size:.95rem;text-align:left}
.highlight-box p{margin:0}
blockquote{margin:0 0 1.5rem;padding:1rem 1.15rem;border-left:4px solid rgba(212,165,98,.3);
  background:rgba(248,250,252,.6);border-radius:0 .5rem .5rem 0;font-style:italic;color:#475569}

/* ---------- thrust cards ---------- */
.thrust-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.25rem}
.thrust-card{background:#fff;border:1px solid #eef2f7;border-radius:.85rem;padding:1.25rem;
  transition:all .3s ease;display:flex;flex-direction:column}
.thrust-card:hover{box-shadow:0 10px 20px -14px rgba(15,23,42,.4);border-color:rgba(212,165,98,.4)}
.thrust-card h3{font-size:1.1rem;font-weight:700;color:var(--primary);margin-bottom:.75rem;
  display:flex;align-items:center;gap:.5rem;transition:color .2s}
.thrust-card:hover h3{color:var(--accent-dark)}
.thrust-card p{font-size:.875rem;line-height:1.65;color:#64748b;margin:0;text-align:justify}

/* ---------- news ---------- */
.news-list{display:flex;flex-direction:column;gap:1rem}
.news-item{display:grid;grid-template-columns:88px 1fr;gap:1.5rem;align-items:baseline;
  padding-bottom:.75rem;border-bottom:1px dashed var(--line)}
.news-item:last-child{border-bottom:none}
.news-date{font-size:.85rem;font-weight:600;color:var(--muted);white-space:nowrap;font-variant-numeric:tabular-nums}
.news-content{font-size:.92rem;color:#334155;line-height:1.6}
.news-content a{color:var(--accent-dark);border-bottom:1px solid rgba(212,165,98,.35)}

/* ---------- publications ---------- */
.pub-year-group{margin-bottom:1.75rem}
.pub-year-header{font-family:'Inter',sans-serif;font-size:1.3rem;font-weight:700;font-style:italic;
  letter-spacing:.05em;color:var(--primary);margin-bottom:1rem;border-bottom:2px solid var(--line);
  padding-bottom:.25rem;display:inline-block}
.pub-list-ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:1.15rem}
.pub-list-item{display:flex;gap:1.4rem;align-items:flex-start;padding:1.2rem;border:1px solid var(--line);
  border-radius:18px;background:linear-gradient(135deg,#fff 0%,#f8fafc 100%);
  transition:border-color .25s ease;line-height:1.5}
.pub-list-item:hover{border-color:rgba(212,165,98,.55)}
.pub-content-wrapper{flex:1 1 auto;min-width:0}
.pub-line-1{display:flex;flex-wrap:wrap;align-items:center;gap:.55rem;margin-bottom:.45rem}
.pub-title-text{font-weight:600;color:var(--primary);font-size:1.05rem;line-height:1.35}
.pub-line-2{font-size:.92rem;color:#4b5563;margin-bottom:.35rem}
.pub-line-2 strong{color:var(--primary);font-weight:700}
.pub-line-2 .meta-note{color:#6BA4E8;font-weight:500}
.pub-line-3{font-size:.88rem;color:var(--muted);display:flex;flex-wrap:wrap;align-items:center;gap:.35rem}
.pub-line-4{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.55rem}
.pub-link-btn{display:inline-block;font-size:.76rem;font-weight:600;padding:.2rem .65rem;
  border:1px solid #dbe4ef;border-radius:999px;color:#475569;background:#fff;transition:all .2s;
  box-shadow:0 8px 16px -14px rgba(15,23,42,.45)}
.pub-link-btn:hover{border-color:rgba(212,165,98,.55);color:var(--accent-dark);background:#fffaf0}
.pub-venue-tag{display:inline-flex;align-items:center;padding:.28rem .8rem;border-radius:999px;
  border:1px solid rgba(148,163,184,.28);background:rgba(255,255,255,.96);font-size:.75rem;
  font-weight:700;letter-spacing:.04em;white-space:nowrap}
.tag-conference{color:var(--accent-dark);border-color:rgba(212,165,98,.36);background:#fffaf0}
.tag-under-review{color:#2563eb;border-color:rgba(37,99,235,.22);background:#eff6ff}
.tag-journal{color:#059669;border-color:rgba(5,150,105,.22);background:#ecfdf5}
.pub-badge-highlight{display:inline-block;background:#ef4444;color:#fff;font-size:.72rem;
  font-weight:700;padding:.16rem .5rem;border-radius:999px;line-height:1.2}
/* framework figures run anywhere from 1.6:1 to 5:1, so the box keeps a fixed
   2:1 frame and the image is contained inside it rather than cropped */
.pub-thumbnail-box{width:250px;aspect-ratio:2/1;flex-shrink:0;position:relative;border-radius:14px;
  overflow:hidden;background:#fff;
  border:1px solid rgba(226,232,240,.9);padding:.45rem;display:flex;align-items:center;justify-content:center}
.pub-thumb-img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;display:block;
  border-radius:4px}
.pub-thumb-placeholder{width:100%;height:100%;border-radius:10px;background:#fff;display:flex;
  align-items:center;justify-content:center;flex-direction:column;gap:.4rem;color:#cbd5e1;font-size:.7rem;
  font-weight:600;letter-spacing:.08em;text-transform:uppercase}
.pub-thumb-placeholder i,.pub-thumb-placeholder .ic{font-size:1.5rem}

/* ---------- timeline / honors ---------- */
.timeline{display:flex;flex-direction:column;gap:1.5rem}
.timeline-item{display:flex;gap:1rem;align-items:flex-start}
.tl-icon{width:3.5rem;height:3.5rem;flex-shrink:0;background:#fff;border-radius:.6rem;
  box-shadow:0 6px 18px -16px rgba(15,23,42,.55);display:flex;align-items:center;justify-content:center;
  border:1px solid #eef2f7;font-size:1.35rem;color:var(--accent)}
.tl-content h3{font-size:1.02rem;font-weight:600;font-family:'Inter',sans-serif;color:var(--primary);margin-bottom:.1rem}
.tl-content .when{font-size:.85rem;color:var(--accent);font-weight:500;margin:0}
.tl-content .desc{font-size:.88rem;color:#64748b;margin:.25rem 0 0;line-height:1.6}
.tl-content ul{margin:.4rem 0 0;padding-left:1.1rem;font-size:.85rem;color:#64748b;line-height:1.65}
.honors-list{display:flex;flex-direction:column;gap:1.1rem}
.honor-item{display:grid;grid-template-columns:110px 1fr;gap:1.5rem;align-items:baseline}
.honor-year{font-family:'Courier New',Courier,monospace;font-weight:700;font-size:.88rem;
  color:var(--accent);text-align:right;white-space:nowrap}
.honor-content h3{font-size:1rem;font-weight:600;font-family:'Inter',sans-serif;color:var(--primary);margin-bottom:.15rem}
.honor-content p{margin:0;color:#64748b;font-size:.88rem}
.honor-content a{color:var(--accent-dark);border-bottom:1px solid rgba(212,165,98,.35)}

/* ---------- blog cards ---------- */
.blog-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:.9rem}
.blog-card{background:#fff;border:1px solid var(--line);border-radius:.75rem;padding:.9rem 1rem;
  transition:all .25s ease}
.blog-card:hover{border-color:rgba(212,165,98,.55);transform:translateY(-2px);
  box-shadow:0 10px 20px -16px rgba(15,23,42,.5)}
.blog-card .t{font-weight:600;color:var(--primary);font-size:.92rem;margin-bottom:.2rem}
.blog-card .d{font-size:.78rem;color:#94a3b8}

/* ---------- contact ---------- */
.contact-card{background:#fff;border-radius:.85rem;border:1px solid var(--line);padding:1.35rem;
  box-shadow:0 6px 18px -18px rgba(15,23,42,.5);transition:all .3s ease}
.contact-card:hover{transform:translateY(-2px);box-shadow:0 10px 15px -3px rgba(0,0,0,.08);border-color:#cbd5e1}
.contact-row{display:flex;align-items:flex-start;gap:.6rem;color:#475569;font-size:.95rem;margin-bottom:.9rem}
.contact-row:last-child{margin-bottom:0}
.contact-row i,.contact-row .ic{color:var(--accent);margin-top:.25rem}
.contact-card h3{font-size:1rem;font-family:'Inter',sans-serif;font-weight:600;color:var(--primary);margin-bottom:.4rem}

footer{border-top:1px solid var(--line);padding:2rem 1.5rem;margin-top:3rem;background:#f1f5f9;
  text-align:center;color:var(--muted);font-size:.85rem}
footer a{color:var(--accent-dark)}

@media(max-width:1100px){
  .profile-card{position:static}
  /* nav collapses into a scrollable strip under the name, never a hidden menu */
  .nav-inner{flex-direction:column;align-items:stretch;gap:.25rem;padding:.65rem 0 0;min-height:0}
  .brand{font-size:1.25rem;padding:0 1.25rem}
  .nav-links{flex-wrap:nowrap;overflow-x:auto;justify-content:flex-start;
    gap:1.1rem;padding:.35rem 1.25rem .6rem;scrollbar-width:none;-ms-overflow-style:none}
  .nav-links::-webkit-scrollbar{display:none}
  .nav-item{font-size:.82rem}
  .nav-item::after{bottom:-3px}
  main{padding-top:8rem}
}
@media(max-width:640px){
  .news-item,.honor-item{grid-template-columns:1fr;gap:.35rem}
  .honor-year{text-align:left}
  .pub-list-item{flex-direction:column}
  .pub-thumbnail-box{width:100%}
  .section-header{flex-direction:column;align-items:flex-start;gap:.4rem}
}

.lnk{color:var(--accent-dark);border-bottom:1px solid rgba(212,165,98,.35)}
.lnk:hover{color:#8b5e2b}
.sub-note{font-size:.85rem;color:#94a3b8;margin:.35rem 0 0}
.pub-note{font-size:.82rem;color:#94a3b8;font-style:italic}
</style>
</head>
