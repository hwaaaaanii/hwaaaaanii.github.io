  <p style="margin-top:.5rem">Design adapted from <a href="https://github.com/yihangtao/AcaNova-X">AcaNova-X</a> · Blog powered by <a href="https://github.com/cotes2020/jekyll-theme-chirpy">Chirpy</a></p>
</footer>

<script>
document.getElementById('y').textContent = new Date().getFullYear();
var secs = [].slice.call(document.querySelectorAll('section[id]'));
var items = [].slice.call(document.querySelectorAll('.nav-item[href^="#"]'));
window.addEventListener('scroll', function(){
  var y = window.scrollY + 120, cur = '';
  secs.forEach(function(s){ if(s.offsetTop <= y) cur = s.id; });
  items.forEach(function(a){
    var on = a.getAttribute('href') === '#'+cur;
    if(on && !a.classList.contains('active')){
      var strip = a.closest('.nav-links');
      if(strip && strip.scrollWidth > strip.clientWidth){
        strip.scrollTo({left: a.offsetLeft - strip.clientWidth/2 + a.offsetWidth/2, behavior:'smooth'});
      }
    }
    a.classList.toggle('active', on);
  });
});
</script>
